# Server Configuration
PORT=3000
NODE_ENV=development
WEBHOOK_URL=https://your-domain.com

# WhatsApp Business API Configuration (from Meta Business Manager)
PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/whatsapp_bot

# Example for Railway/Render (they provide this automatically):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
