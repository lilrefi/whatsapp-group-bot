# Server
PORT=3000

# REST API (consumed by db_revamp Next.js dashboard)
BOT_API_PORT=3001
BOT_API_KEY=your-secret-key-here

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Order buffer: minutes before an unconfirmed order is auto-placed
ORDER_BUFFER_MINUTES=10

# Order-taking hiatus: set to "false" to stop parsing incoming group messages
# into orders (no transcription/OCR/sessions). Baileys connection, group_profiles
# links, and outbound sends (POST /api/send-message) keep working either way.
# Defaults to enabled (true) if unset.
ORDER_TAKING_ENABLED=true
