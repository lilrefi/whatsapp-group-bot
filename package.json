{
  "name": "whatsapp-ordering-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot for product ordering with Meta Business API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup-db": "node run-sql.js schema_product.sql",
    "migrate": "node run-sql.js migration_groups.sql",
    "migrate-code": "node run-sql.js migration_customer_code.sql",
    "migrate-status": "node run-sql.js migration_order_status.sql",
    "migrate-zh": "node run-sql.js migration_name_zh.sql",
    "migrate-attachments": "node run-sql.js migration_attachments.sql"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "ordering",
    "meta",
    "api"
  ],
  "author": "Refi Daffa",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@hapi/boom": "^10.0.1",
    "@vercel/blob": "^2.4.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
