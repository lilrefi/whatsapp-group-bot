# Server
PORT=3000

# REST API (consumed by db_revamp Next.js dashboard)
BOT_API_PORT=3001
BOT_API_KEY=your-secret-key-here

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Order buffer: minutes before an unconfirmed order is auto-placed
ORDER_BUFFER_MINUTES=10

# ── Voice-to-Text (Faster Whisper) ─
# Optional: path to a Python venv that has faster-whisper installed.
# If not set, the system python3 is used.
# Example: /home/user/whatsapp-group-bot/venv
# PYTHON_VENV_PATH=